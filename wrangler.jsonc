/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portal-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-08",
	"d1_databases": [
		{
			"binding": "portal_db",
			"database_name": "portal-db",
			"database_id": "d767fe9d-84f5-436f-a8dc-85370c179a3a"
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"GOOGLE_CLIENT_ID": "296921667290-ppud7lh91ojm5ujosof5394t13o7jtv2.apps.googleusercontent.com",
		"SESSION_SECRET": "8892992383feeara-67fe9d-84f5-436f-iekdj-85370c179a3a-xbaftazbaxxxc5644932356",

		"GITHUB_REPO": "meltsas/non-touristic-rentals",
		"GITHUB_EXPORT_ENABLED": true,
		"GITHUB_EXPORT_DRY_RUN": false,
		"GITHUB_BRANCH": "master",
		"GITHUB_COMMITTER_NAME": "Portal Data Bot",
		"GITHUB_COMMITTER_EMAIL": "portal-data-bot@gmail.com",
		"GITHUB_WEATHER_FILE_PATH": "app/data/weather/open-meteo-responses.json",
		"GITHUB_MARINE_FILE_PATH": "app/data/marine/open-meteo-responses.json"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Scheduled (cron) triggers. Keep cron expressions in sync with the
	// constants in `src/scheduled/handlers.ts` — the scheduled() handler
	// dispatches on `controller.cron`. Cron expressions are evaluated in UTC.
	//   "7 * * * *"   hourly external data fetch (Open-Meteo, etc.)
	//   "9 * * * *"   hourly trigger for the smart GitHub export placeholder.
	//                 Handler gates against an `Europe/Madrid` publish window
	//                 so only ~9 of 24 daily firings actually pass the guard;
	//                 the rest log a clean skip. Firing every hour (vs every
	//                 2h) keeps the window aligned across DST.
	"triggers": {
		"crons": [
			"7 * * * *",
			"9 * * * *"
		]
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
